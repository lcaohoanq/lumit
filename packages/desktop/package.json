{
  "name": "@luucaohoang/lumit-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Electron desktop app for Lumit.",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "bun run build:main && bun run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "bun run build && node ../../scripts/ensure-electron.mjs && node ../../scripts/run-electron.mjs dist/main/index.js",
    "typecheck": "tsc -b tsconfig.main.json && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@luucaohoang/lumit-core": "file:../core",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.3.2",
    "vite": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
}
