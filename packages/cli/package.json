{
  "name": "@luucaohoang/lumit",
  "version": "0.1.3",
  "description": "Create starter projects quickly with install, git, and optional GitHub setup.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "bin": {
    "lumit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "cli",
    "starter",
    "vite",
    "react",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lcaohoanq/lumit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/lcaohoanq/lumit/issues"
  },
  "homepage": "https://github.com/lcaohoanq/lumit#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.3",
    "@luucaohoang/lumit-core": "0.1.3",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "tsx": "^4.19.3"
  },
  "engines": {
    "node": ">=20"
  }
}
