{
  "name": "lumit-monorepo",
  "version": "0.1.4",
  "private": true,
  "description": "Monorepo for Lumit CLI, shared core, and desktop app.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/desktop"
  ],
  "scripts": {
    "build": "bun run --filter @luucaohoang/lumit-core build && bun run --filter @luucaohoang/lumit build && bun run --filter @luucaohoang/lumit-desktop build",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "dev:cli": "bun run --filter @luucaohoang/lumit dev --",
    "dev:desktop": "bun run --filter @luucaohoang/lumit-desktop dev",
    "repair:electron": "node scripts/ensure-electron.mjs",
    "pack:core": "bun pm pack --dry-run --cwd packages/core",
    "pack:cli": "bun pm pack --dry-run --cwd packages/cli"
  },
  "devDependencies": {
    "@electron/get": "^5.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
