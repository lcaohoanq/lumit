{
  "name": "@luucaohoang/lumit",
  "version": "0.1.3",
  "description": "A modular starter project generator CLI for developers.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "bin": {
    "lumit": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "cli",
    "starter",
    "vite",
    "react",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/lcaohoanq/lumit.git"
  },
  "bugs": {
    "url": "https://github.com/lcaohoanq/lumit/issues"
  },
  "homepage": "https://github.com/lcaohoanq/lumit#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.3",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
