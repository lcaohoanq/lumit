{
  "name": "lumit-monorepo",
  "version": "0.1.3",
  "private": true,
  "description": "Monorepo for Lumit CLI, shared core, and desktop app.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:cli": "npm run dev --workspace packages/cli --",
    "dev:desktop": "npm run dev --workspace packages/desktop",
    "repair:electron": "node scripts/ensure-electron.mjs",
    "pack:cli": "npm pack --workspace packages/cli --dry-run"
  },
  "devDependencies": {
    "@electron/get": "^5.0.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
